#include <iostream>
using namespace std;

int main()
{
    int category, choice, quantity;
    int total = 0;
    char again;

    do
    {

                                                                                               
        cout << "\n             Welcome to";     
        cout << "\n          Brandons' Oasis";

        cout << "\n\n***************************************";
        cout << "\n          CHOOSE SERVICE";
        cout << "\n***************************************";
        cout << "\n1. ROOM BOOKING (IN PROGRESS)";
        cout << "\n2. ROOM CLEANING (IN PROGRESS)";
        cout << "\n3. PAYMENT SYSTEM (PLACEHOLDER)";
        cout << "\n4. EXIT";

        cout << "\n\nEnter Category(1-4): ";
        cin >> category;

        switch (category)
        {
            // =========================
            // ROOM BOOKING
            // =========================
            case 1:
            {
                do
                {
                    cout << "\n\n******** ROOM BOOKING ********";
                    cout << "\n1. Standard Room - ₱1299";
                    cout << "\n2. Deluxe Room - ₱2499";
                    cout << "\n3. Suite Room - ₱3350";

                    cout << "\n\nEnter Room type: ";
                    cin >> choice;

                    cout << "Enter Number of Rooms: ";
                    cin >> quantity;

                    switch (choice)
                    {
                        case 1:
                            total += 677 * quantity;
                            cout << "Standard Room added!";
                            break;

                        case 2:
                            total += 850 * quantity;
                            cout << "Deluxe Room added!";
                            break;

                        case 3:
                            total += 1200 * quantity;
                            cout << "Suite Room added!";
                            break;

                        default:
                            cout << "Invalid room choice!";
                    }

                    cout << "\nBook another room? (Y/N): ";
                    cin >> again;

                } while (again == 'Y' || again == 'y');

                break;

            }

            // =========================
            // ROOM CLEANING
            // =========================
            case 2:
            {
                do
                {
                    cout << "\n\n******** ROOM CLEANING ********";
                    cout << "\n          Cleaning Service ";
                    cout << "\n !!This will add aditional Fee(₱330)!!";

                    cout << "\n\nYes[1]/No[2]: ";
                    cin >> choice;


                    switch (choice)
                    {
                        case 1:
                            total += 330;
                            cout << "Service added";
                            break;

                        case 2:
                            cout << "Placeholder4882";
                            break;


                        default:
                            cout << "Invalid cleaning choice!";
                    }

                    cout << "\nExit? (Y/N): ";
                    cin >> again;

                } while (again == 'N' || again == 'n');

                break;
            }

            // =========================
            // PAYMENT SYSTEM
            // =========================
            case 3:
            {
                cout << "\n\n******** PAYMENT SYSTEM ********";
                cout << "\nCurrent Total: ₱" << total;

                if (total > 0)
                {
                    int payment;

                    cout << "\n\n1. Cash";
                    cout << "\n2. Credit/Debit Card";
                    cout << "\n3. Online Payment";

                    cout << "\n\nChoose Payment Method: ";
                    cin >> payment;

                    switch (payment)
                    {
                        case 1:
                            cout << "\nPayment through Cash selected.";
                            break;

                        case 2:
                            cout << "\nPayment through Card selected.";
                            break;

                        case 3:
                            cout << "\nOnline Payment selected.";
                            break;

                        default:
                            cout << "\nInvalid payment method!";
                    }
                }
                else
                {
                    cout << "\nNo orders yet!";
                }

                break;

            }

            // =========================
            // EXIT
            // =========================
            case 4:
                cout << "\nThank you for using our service!";
                break;

            default:
                cout << "\nInvalid category!";
        }

        // Show current total after each category
        if (category != 3)
        {
            cout << "\n\n***************************************";
            cout << "\nCURRENT TOTAL: ₱" << total;
            cout << "\n***************************************";

            cout << "\n\nReturn to main menu? (Y/N): ";
            cin >> again;
        }

    } while (category != 3 && (again == 'Y' || again == 'y'));

    cout << "\n\nFinal Total: ₱" << total;
    cout << "\nThank you!";

    return 0;
}
